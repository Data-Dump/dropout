# ==============================================================================
# DROPOUT CAFE & RESTRO - Environment Variables Template
# Copy this file to .env.local for local development.
# Configure these variables in Vercel Project Settings > Environment Variables for deployment.
# NEVER commit .env.local or production secrets to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Base URL
# ------------------------------------------------------------------------------
# Local development:  http://localhost:3000
# Production:         https://your-domain.vercel.app (no trailing slash)
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Public Anon Key and URL are safe for browser use
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Service Role Key (CRITICAL: Server-side only, never expose to client!)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# PhonePe / UPIPay Payment Credentials (Server-side only)
# ------------------------------------------------------------------------------
# Environment: "sandbox" for UAT testing or "production" for live transactions
PHONEPE_ENV=sandbox

# Merchant ID provided by PhonePe (e.g. PGTESTPAYUAT for sandbox)
PHONEPE_MERCHANT_ID=your_merchant_id_here

# Salt Key (AES key provided by PhonePe dashboard)
PHONEPE_SALT_KEY=your_salt_key_here

# Salt Index (Usually "1" as assigned by PhonePe)
PHONEPE_SALT_INDEX=1

# Webhook Callback URL: Must be a publicly reachable HTTPS endpoint on your deployment
# e.g. https://your-domain.vercel.app/api/payments/webhook
PHONEPE_CALLBACK_URL=https://your-domain.vercel.app/api/payments/webhook

# UPI VPA for Dynamic QR & Intent generation
PHONEPE_VPA=yourcafe@upi
CAFE_UPI_VPA=yourcafe@upi

# ------------------------------------------------------------------------------
# Cafe POS Operational Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CAFE_NAME="DROPOUT Cafe & Restro"
NEXT_PUBLIC_CAFE_WHATSAPP_PHONE="919999999999"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"
NEXT_PUBLIC_TABLE_COUNT=10
# Server-side signing secret for staff HttpOnly session cookies (generate 32+ random bytes)
STAFF_SESSION_SECRET=replace_with_random_32_byte_hex_secret

# ------------------------------------------------------------------------------
# Predefined Supabase Role Credentials
# ------------------------------------------------------------------------------
SUPERADMIN_EMAIL=superadmin@yourcafe.in
SUPERADMIN_PASSWORD=your_superadmin_password_here
KITCHEN_EMAIL=kitchen@yourcafe.in
KITCHEN_PASSWORD=your_kitchen_password_here

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway Configuration
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
